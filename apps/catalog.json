    {
      "id": "openresty",
      "name": "OpenResty",
      "category": "web",
      "icon": "globe",
      "summary": "反向代理、静态站点、HTTPS 证书;装好后在「网站」页管理站点",
      "description": "基于 Nginx 和 LuaJIT 的高性能 Web 平台,装好后在「网站」页管理站点。",
      "features": [
        "反向代理、静态站点托管",
        "HTTPS 证书与多域名、多端口监听",
        "Lua 脚本扩展,可写动态逻辑",
        "Otter 的「网站」页直接管理它的站点配置"
      ],
      "website": "https://openresty.org",
      "repo": "https://github.com/openresty/openresty",
      "arch": [
        "amd64",
        "arm64"
      ],
      "kind": "website",
      "profile": "openresty",
      "versions": {
        "source": "dockerhub",
        "repo": "openresty/openresty",
        "match": "^\\d+(\\.\\d+){3}-alpine$",
        "default": "latest",
        "extra": [
          "alpine"
        ],
        "pages": 10,
        "search": "-alpine",
        "fallback": [
          "1.31.9.1-alpine",
          "1.31.8.1-alpine",
          "1.31.1.1-alpine",
          "1.29.2.5-alpine",
          "1.29.2.4-alpine",
          "1.29.2.3-alpine",
          "1.29.2.2-alpine",
          "1.29.2.1-alpine",
          "1.27.1.2-alpine",
          "1.27.1.1-alpine",
          "1.25.3.2-alpine",
          "1.25.3.1-alpine",
          "1.21.4.4-alpine",
          "1.21.4.3-alpine",
          "1.21.4.2-alpine",
          "1.21.4.1-alpine",
          "1.19.9.1-alpine",
          "1.12.4.2-alpine"
        ]
      },
      "limits": true,
      "params": [
        {
          "id": "http",
          "label": "HTTP 端口",
          "type": "port",
          "default": 80,
          "min": 1,
          "help": "容器用 host 网络,由 OpenResty 直接占用;默认站点监听它,新建站点也以它为默认端口。证书的 HTTP 验证需要公网能访问 80"
        },
        {
          "id": "https",
          "label": "HTTPS 端口",
          "type": "port",
          "default": 443,
          "min": 1
        }
      ],
      "compose": "# managed by otter (layout 1)\nservices:\n  openresty:\n    image: openresty/openresty:${version}\n    container_name: ${container}\n    network_mode: host\n    restart: unless-stopped\n    ${limits}\n    labels:\n      otter.managed: websites\n      otter.app: openresty\n    volumes:\n      - /opt/otter/websites/conf/nginx.conf:/usr/local/openresty/nginx/conf/nginx.conf:ro\n      - /opt/otter/websites/conf/conf.d:/etc/nginx/conf.d:ro\n      - /opt/otter/websites/certs:/etc/otter/certs:ro\n      - /opt/otter/websites/sites:/www/sites:ro\n      - /opt/otter/websites/acme-webroot:/www/acme:ro\n      - /opt/otter/websites/logs:/var/log/nginx\n"
    },

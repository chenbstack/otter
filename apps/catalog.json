    {
      "id": "postgres",
      "name": "PostgreSQL",
      "category": "database",
      "icon": "database",
      "summary": "关系型数据库",
      "description": "功能完备的开源关系型数据库,以可靠性、标准兼容和扩展能力著称。",
      "features": [
        "完整 SQL 支持与事务(ACID)",
        "JSON/JSONB、全文检索、地理数据(PostGIS 扩展)",
        "主从流复制、逻辑复制、时间点恢复",
        "丰富的索引类型与扩展生态"
      ],
      "website": "https://www.postgresql.org",
      "repo": "https://github.com/postgres/postgres",
      "arch": [
        "amd64",
        "arm64"
      ],
      "kind": "database",
      "versions": {
        "source": "dockerhub",
        "repo": "library/postgres",
        "match": "^\\d+(\\.\\d+){0,2}$",
        "default": "pin:18",
        "fallback": [
          "19.0",
          "19",
          "18.7",
          "18.6",
          "18.4",
          "18.3",
          "18.2",
          "18.1",
          "18",
          "17.12",
          "17.11",
          "17.10",
          "17.9",
          "17.8",
          "17.7",
          "17",
          "16.16",
          "16.15",
          "16.14",
          "16.13",
          "16.12",
          "16.11",
          "16",
          "15.20",
          "15.19",
          "15.18",
          "15.17",
          "15.16",
          "15.15",
          "15"
        ]
      },
      "limits": true,
      "params": [
        {
          "id": "port",
          "label": "宿主机端口",
          "type": "port",
          "default": 5432,
          "min": 1024,
          "autoFree": true
        },
        {
          "id": "password",
          "label": "管理员密码",
          "type": "password",
          "generate": true,
          "secret": true,
          "env": "DB_PASSWORD",
          "showOnce": true
        },
        {
          "id": "public",
          "label": "对外开放端口",
          "type": "bool",
          "default": false,
          "warn": "数据库暴露在公网上有被扫描、爆破的风险,请确认防火墙和密码强度"
        }
      ],
      "derive": [
        {
          "id": "bind",
          "from": "public",
          "map": {
            "true": "",
            "false": "127.0.0.1:"
          }
        },
        {
          "id": "data_dir",
          "from": "version",
          "rules": [
            {
              "major_gte": 18,
              "value": "/var/lib/postgresql"
            }
          ],
          "default": "/var/lib/postgresql/data"
        }
      ],
      "compose": "services:\n  db:\n    image: postgres:${version}\n    container_name: ${container}\n    restart: unless-stopped\n    ${limits}\n    ports:\n      - \"${bind}${port}:5432\"\n    volumes:\n      - ./data:${data_dir}\n    environment:\n      POSTGRES_PASSWORD: ${env.password}\n    labels:\n      otter.managed: db\n      otter.app: postgres\n",
      "post": {
        "notes": "管理员密码只显示这一次,Otter 不保存",
        "show": [
          "password"
        ]
      }
    },
